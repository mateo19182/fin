[Unit]
Description=fin weekly digest to Telegram (silent when nothing is notable)
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/projects/personal/fin
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=%h/projects/personal/fin/.venv/bin/fin digest --send
TimeoutStartSec=5min
UMask=0077
